{
  "name": "pokemon-splendor-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "포켓몬 스플렌더 시뮬레이터 — 2~4인(유저 1 + AI 1~3) 실시간 승리 확률 표시",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:cardex": "vite-node scripts/gen-cardex.ts",
    "tune": "vite-node scripts/tune.ts --",
    "tune:bench": "vite-node scripts/tune.ts -- --bench",
    "eval:mcts": "vite-node scripts/eval-mcts.ts --",
    "eval:players": "vite-node scripts/eval-players.ts --"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4"
  }
}
